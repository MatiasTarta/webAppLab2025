{
  "expo": {
    "name": "aticodevilmamobile",
    "slug": "aticodevilmamobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aticodevilmamobile",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}